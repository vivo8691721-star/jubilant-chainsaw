	if lagging then return end
	lagging = true

	task.spawn(function()
		local start = tick()
		while tick() - start < time do
			local t = {}
			for i = 1, 4e6 do
				t[i] = math.random()
			end
			RunService.Heartbeat:Wait()
		end
		lagging = false
	end)
end

