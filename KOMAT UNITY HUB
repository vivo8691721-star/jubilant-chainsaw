local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer

local autoReviveEnabled = false
local autoRespawnMethod = "Fake Revive"
local lastSavedPosition = nil

local function setupAutoRevive(character)
task.defer(function()
local hrp = character:WaitForChild("HumanoidRootPart", 5)
local humanoid = character:WaitForChild("Humanoid", 5)
if not hrp or not humanoid then return end

-- เก็บตำแหน่งล่าสุด
task.spawn(function()
while character and character.Parent do
local root = character:FindFirstChild("HumanoidRootPart")
if root then
character:SetAttribute("LastPosition", root.Position)
lastSavedPosition = root.Position
end
task.wait(0.2)
end
end)

-- Downed system
character:GetAttributeChangedSignal("Downed"):Connect(function()
if not autoReviveEnabled then return end
if character:GetAttribute("Downed") ~= true then return end
if autoRespawnMethod ~= "Fake Revive" then return end

if hrp then          
    lastSavedPosition = hrp.Position          
end          

task.wait(3)          

local start = tick()          

repeat          
    pcall(function()          
        ReplicatedStorage:WaitForChild("Events", 9e9)          
            :WaitForChild("Player", 9e9)          
            :WaitForChild("ChangePlayerMode", 9e9)          
            :FireServer(true)          
    end)          
    task.wait(1)          
until character:GetAttribute("Downed") ~= true or tick() - start > 6          

local newChar = player.Character or player.CharacterAdded:Wait()          
local newHRP = newChar:WaitForChild("HumanoidRootPart")          

if lastSavedPosition and newHRP then          
    newHRP.CFrame = CFrame.new(lastSavedPosition + Vector3.new(0, 3, 0))          
    task.wait(0.5)          
end

end)

end)

end

-- รีสตาร์ทตอนเกิดตัวละครใหม่
player.CharacterAdded:Connect(function(char)
if autoReviveEnabled then
setupAutoRevive(char)
end
end)

