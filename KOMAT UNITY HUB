-- =========================
-- TP Downed Player System
-- =========================

local floatingDownedButton

local function teleportToDowned()

    local myChar = player.Character
    if not myChar then return end

    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    local originalPos = myRoot.CFrame
    local targetRoot = nil

    -- หา player ที่ Downed หรือเลือด 0
    for _,plr in pairs(game.Players:GetPlayers()) do
        if plr ~= player and plr.Character then

            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local root = plr.Character:FindFirstChild("HumanoidRootPart")

            if hum and root then
                if hum.Health <= 0 or plr.Character:GetAttribute("Downed") == true then
                    targetRoot = root
                    break
                end
            end

        end
    end

    -- ถ้าเจอ
    if targetRoot then

        myRoot.CFrame = targetRoot.CFrame + Vector3.new(0,3,0)

        task.wait(2)

        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            player.Character.HumanoidRootPart.CFrame = originalPos
        end

    end
end

